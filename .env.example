# Masold at .env fajlba: cp .env.example .env
# A .env nincs verziokezelve, a valos titkok csak ott szerepelnek.

# Szerver
NODE_ENV=development
PORT=3000

# Adatbazis (a kapcsolat kesobbi fejezetben keszul el)
DATABASE_URL=postgres://user:password@localhost:5432/and_order_here

# Autentikacio - eles kornyezetben cserelendo hosszu, veletlen ertekre
JWT_SECRET=change-me

# Socket.io / API CORS
CORS_ORIGIN=*
