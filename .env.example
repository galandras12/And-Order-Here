# Masold at .env fajlba: cp .env.example .env
# A .env nincs verziokezelve, a valos titkok csak ott szerepelnek.

# Szerver
NODE_ENV=development
PORT=3000

# Fajlalapu (JSON) adattarolas - nincs szukseg kulon adatbazis-szerverre.
# Az utvonal relativ is lehet; a fajl elso indulaskor automatikusan letrejon.
DATA_FILE=server/db/data.json
# Ures adatbazis eseten a szerver indulaskor betolti a teszt adatokat (seed).
SEED_ON_EMPTY=true

# Kesobbi kulso adatbazishoz tartjuk fenn; a JSON tarolas nem hasznalja.
DATABASE_URL=

# Autentikacio - eles kornyezetben cserelendo hosszu, veletlen ertekre
JWT_SECRET=change-me

# Socket.io / API CORS
CORS_ORIGIN=*
